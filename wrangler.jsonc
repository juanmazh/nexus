{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "nexus",
	"main": "./worker/index.ts",
	"compatibility_date": "2026-10-07",
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS",
		// Cualquier ruta que no sea un asset real devuelve index.html para que la
		// resuelva el router del cliente. Con esto, las navegaciones NO invocan el
		// Worker y no gastan invocaciones del plan gratuito.
		"not_found_handling": "single-page-application",
		// Salvo /api/*, que sí la atiende el Worker.
		"run_worker_first": ["/api/*"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "nexus-db",
			"migrations_dir": "migrations",
			// Creada con `pnpm wrangler d1 create nexus-db`. No es un secreto.
			// `pnpm dev` usa siempre la D1 local de Miniflare, nunca esta.
			"database_id": "9e08bf84-912c-4ccf-ae10-e4df4e1af7b0"
		}
	],
	// Un único Cron Trigger (1 de los 5 de la cuenta): el job de recordatorios,
	// cada 5 minutos en UTC (docs/ARCHITECTURE.md §3.3). 288 invocaciones al día.
	"triggers": {
		"crons": ["*/5 * * * *"]
	},
	"vars": {
		"APP_TIMEZONE": "Europe/Madrid",
		// Dominio del equipo de Zero Trust, SIN esquema: el código construye
		// `https://${ACCESS_TEAM_DOMAIN}` una sola vez y lo usa como emisor.
		// No es un secreto. ACCESS_AUD sí lo es (wrangler secret put).
		"ACCESS_TEAM_DOMAIN": "juanmazh.cloudflareaccess.com"
	},
	"observability": {
		"enabled": true,
		// Trazas apagadas a propósito: registrarían la URL de cada `fetch` saliente,
		// y la de Telegram lleva el token del bot en la ruta (/bot<token>/...).
		// Los logs no la incluyen: el código nunca la escribe (add-reminders D8).
		"traces": { "enabled": false }
	}
}
