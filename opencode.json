{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      ".dev.vars": "deny",
      ".dev.vars.*": "deny",
      ".dev.vars.example": "allow"
    },
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      ".dev.vars": "deny",
      ".dev.vars.*": "deny",
      ".dev.vars.example": "allow"
    },
    "bash": {
      "*": "ask",
      "pnpm install*": "allow",
      "pnpm dev*": "allow",
      "pnpm build*": "allow",
      "pnpm typecheck*": "allow",
      "pnpm lint*": "allow",
      "pnpm format*": "allow",
      "pnpm test*": "allow",
      "pnpm db:generate*": "allow",
      "pnpm db:migrate:local*": "allow",
      "pnpm cf-typegen*": "allow",
      "openspec *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git add*": "allow",
      "git commit*": "allow",
      "git switch*": "allow",
      "*.dev.vars*": "deny",
      "*.env*": "deny",
      "*wrangler secret*": "deny",
      "pnpm deploy*": "deny",
      "pnpm db:migrate:remote*": "deny",
      "*wrangler deploy*": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "rm -rf*": "deny"
    }
  }
}
