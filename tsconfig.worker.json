{
	"compilerOptions": {
		"target": "es2022",
		"module": "esnext",
		"moduleResolution": "bundler",
		// No "dom": the Worker has no document, so an accidental one is a type error.
		"lib": ["es2022"],
		"types": ["./worker-configuration.d.ts", "@cloudflare/vitest-plugin/types"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"noEmit": true,
		"paths": {
			"@shared/*": ["./shared/*"]
		}
	},
	"include": ["worker", "shared", "vitest.setup.worker.ts"]
}
