{
	"name": "nexus",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.9.1",
	"engines": {
		"node": ">=20.19"
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"typecheck": "tsc -b",
		"lint": "biome check",
		"format": "biome check --write",
		"test": "vitest run --reporter=verbose",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply nexus-db --local",
		"db:migrate:remote": "wrangler d1 migrations apply nexus-db --remote",
		"cf-typegen": "wrangler types",
		"deploy": "pnpm build && wrangler deploy"
	},
	"dependencies": {
		"@base-ui/react": "^1.8.0",
		"@fontsource-variable/geist": "^5.3.0",
		"@tanstack/react-query": "^5.104.1",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.4.0",
		"drizzle-orm": "^0.45.3",
		"hono": "^4.13.13",
		"lucide-react": "^1.52.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-router": "^8.4.0",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@cloudflare/vite-plugin": "^1.63.0",
		"@cloudflare/vitest-plugin": "^1.3.7",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.7",
		"@types/node": "^24.10.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"@vitest/runner": "^4.1.11",
		"@vitest/snapshot": "^4.1.11",
		"drizzle-kit": "^0.31.11",
		"jsdom": "^30.1.2",
		"shadcn": "^4.21.3",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"vite": "^8.3.3",
		"vitest": "^4.1.11",
		"wrangler": "^4.148.0"
	}
}
